{
  "name": "devworkbench",
  "version": "1.0.0",
  "description": "DevWorkbench - 一站式开发者工作台，融合知识库管理与开发工具箱",
  "author": "DevWorkbench Contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhaoliangcn/DevWorkbench.git"
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "tsc -p tsconfig.preload.json && tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron dist-electron/main.js --no-sandbox",
    "electron:start": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "build": "tsc -b && vite build",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && electron-builder",
    "electron:publish": "npm run build && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && electron-builder --publish always",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dev-assistant-ts": "git+https://github.com/zhaoliangcn/dev-assistant-ts.git#ba463c37e993f8efb0ac67b5a577096e8a39a76b",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "node-ssh": "^13.2.1",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.6.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "docx": "^9.6.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "html2pdf.js": "^0.14.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "monaco-editor": "^0.44.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.12"
  },
  "build": {
    "appId": "com.devworkbench.app",
    "productName": "DevWorkbench",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "zhaoliangcn",
      "repo": "DevWorkbench",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/ssh2/util/pagent.exe"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/devworkbench.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
